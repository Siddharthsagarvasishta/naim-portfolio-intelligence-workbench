# nAIM Portfolio Intelligence Workbench — executable local configuration
NAIM_RANDOM_SEED=73421
NAIM_DATASET_PROFILE=default
NAIM_DATA_DIR=./data
NAIM_DATA_MODE=OFFLINE_SNAPSHOT
NAIM_LOG_LEVEL=INFO
NAIM_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Authentication is deliberately disabled for private local development only.
# Set NAIM_AUTH_MODE=demo (AUTH_MODE is also accepted), create a 32+ character
# signing secret, then provision accounts with `make auth-setup-demo`.
NAIM_AUTH_MODE=disabled
NAIM_TOKEN_SECRET=replace-with-at-least-32-random-characters
NAIM_TOKEN_TTL_SECONDS=3600
NAIM_TOKEN_ISSUER=naim-local
NAIM_TOKEN_AUDIENCE=naim-workbench
NAIM_DATABASE_URL=sqlite+pysqlite:///data/state/naim_workflow.sqlite3

# OIDC adapter coordinates are required only when NAIM_AUTH_MODE=oidc.
# NAIM_OIDC_ISSUER=https://identity.example.com/
# NAIM_OIDC_AUDIENCE=naim-workbench
# NAIM_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# NAIM_OIDC_ROLE_CLAIM=naim_role

# Frontend calls the local API by default.
NEXT_PUBLIC_NAIM_API_URL=http://localhost:8000/api/v1
